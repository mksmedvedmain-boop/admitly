# Скопируй в .env (локально) или заполни в панели Render (Environment).
# Все переменные опциональны для локального запуска: без них приложение
# работает в «гостевом» режиме, соцвход и оплата честно сообщают, что не
# настроены (никаких фейковых кнопок).

# --- База данных -------------------------------------------------------------
# Локально по умолчанию — SQLite рядом с кодом. На Render: строка Internal
# Database URL из панели Postgres-сервиса (без неё данные стираются при
# перезапуске!). Пример: postgresql://admitly:pass@dpg-xxx:5432/admitly
DATABASE_URL=sqlite:///./unimatch.db

# --- CORS --------------------------------------------------------------------
# Домены фронтенда через запятую. Без переменной разрешены все origin —
# удобно локально, но в проде обязательно ограничь.
ADMITLY_CORS_ORIGINS=https://your-frontend-domain.example

# --- Демо-режим Premium --------------------------------------------------------
# Только для локальной демонстрации: кнопка включает Premium без оплаты.
# В проде НЕ задавать — иначе любой пользователь выдаст себе премиум сам.
# ADMITLY_DEMO_PREMIUM=1

# --- Соцвход (Google / Яндекс / Telegram) --------------------------------------
# Client ID — публичные, живут в app.js (OAUTH). Секреты — только здесь.
# Google:   console.cloud.google.com -> Credentials -> OAuth client ID
# Яндекс:   oauth.yandex.ru -> зарегистрировать приложение
# Telegram: @BotFather -> /newbot; токен нужен бэкенду для проверки подписи
TELEGRAM_BOT_TOKEN=

# --- Оплата Premium (Stripe) ---------------------------------------------------
# dashboard.stripe.com (сначала Test mode):
#   STRIPE_SECRET_KEY    — Developers -> API keys -> Secret key (sk_test_...)
#   STRIPE_PRICE_ID     — Product «Admitly Premium» -> цена (price_...)
#   STRIPE_WEBHOOK_SECRET — Developers -> Webhooks -> Signing secret (whsec_...)
#     эндпоинт: https://<api-домен>/payments/webhook, события:
#     checkout.session.completed, customer.subscription.deleted, invoice.payment_failed
#   FRONTEND_URL        — домен фронтенда для страниц успеха/отмены оплаты
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5500
